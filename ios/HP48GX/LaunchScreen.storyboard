<?xml version="1.0" encoding="UTF-8"?>
<!-- The launch screen: the calculator's face (LaunchFace, made by
     ios/launch/make_launch.py) fitted into the safe area and centred, as the
     app fits the calculator, on the app's background colour. -->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="LCh-vc-001">
    <device id="retina6_12" orientation="portrait" appearance="dark"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="LCh-sc-001">
            <objects>
                <viewController id="LCh-vc-001" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="LCh-vw-001">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchFace" translatesAutoresizingMaskIntoConstraints="NO" id="LCh-im-001">
                                <rect key="frame" x="0.0" y="59" width="393" height="759"/>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="LCh-sa-001"/>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <constraint firstItem="LCh-im-001" firstAttribute="top" secondItem="LCh-sa-001" secondAttribute="top" id="LCh-ct-001"/>
                            <constraint firstItem="LCh-sa-001" firstAttribute="bottom" secondItem="LCh-im-001" secondAttribute="bottom" id="LCh-ct-002"/>
                            <constraint firstItem="LCh-im-001" firstAttribute="leading" secondItem="LCh-sa-001" secondAttribute="leading" id="LCh-ct-003"/>
                            <constraint firstItem="LCh-sa-001" firstAttribute="trailing" secondItem="LCh-im-001" secondAttribute="trailing" id="LCh-ct-004"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="LCh-fr-001" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchFace" width="435" height="812"/>
        <namedColor name="LaunchBackground">
            <color red="0.070588235294117646" green="0.070588235294117646" blue="0.078431372549019607" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
